{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 $HOME/.multi-agent-chat/skill/multi-agent-chat/scripts/chat.py hook codex relay"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 $HOME/.multi-agent-chat/skill/multi-agent-chat/scripts/chat.py hook codex bind"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 $HOME/.multi-agent-chat/skill/multi-agent-chat/scripts/chat.py hook codex stop"
        }
      ]
    }
  ]
}
